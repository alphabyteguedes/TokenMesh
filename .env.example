# ============================================================
# TokenMesh Configuration
# Copy this file to .env and fill in your API keys
# ============================================================

# --- Provider API Keys (at least one required) ---
TOKENMESH_OPENAI_API_KEY=sk-your-openai-key-here
TOKENMESH_ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# --- Server ---
TOKENMESH_HOST=0.0.0.0
TOKENMESH_PORT=8787
TOKENMESH_LOG_LEVEL=info

# --- Database ---
TOKENMESH_DUCKDB_PATH=data/tokenmesh.duckdb

# --- Cache ---
TOKENMESH_CACHE_ENABLED=true
TOKENMESH_CACHE_SIMILARITY_THRESHOLD=0.95

# --- Pipeline ---
TOKENMESH_DLP_ENABLED=true
TOKENMESH_COMPRESSION_ENABLED=true

# --- Embedding ---
TOKENMESH_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TOKENMESH_EMBEDDING_DIM=384

# --- Display ---
TOKENMESH_DEFAULT_CURRENCY=USD
TOKENMESH_DEFAULT_LANGUAGE=pt-br

# --- CORS ---
TOKENMESH_CORS_ORIGINS=["*"]
